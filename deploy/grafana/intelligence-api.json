{
  "uid": "intelligence-api",
  "title": "Intelligence API",
  "description": "Service metrics for the Intelligence API: HTTP traffic, lookups, cache, rate limiting and dependencies. Source: deploy/grafana/intelligence-api.json in the intelligence-api repository.",
  "tags": ["intelligence-api"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(intelligence_api_build_info, app)",
        "definition": "label_values(intelligence_api_build_info, app)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {}
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(intelligence_api_build_info{app=~\"$app\"}, instance)",
        "definition": "label_values(intelligence_api_build_info{app=~\"$app\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Version",
      "description": "The version each instance reports, from the build_info gauge. Two values during a deploy, one otherwise.",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "instant": true, "legendFormat": "{{version}}", "expr": "count by (version) (intelligence_api_build_info{app=~\"$app\",instance=~\"$instance\"})" }
      ],
      "options": { "textMode": "name", "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2, "type": "stat", "title": "Requests",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(intelligence_api_http_request_duration_seconds_count{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3, "type": "stat", "title": "5xx ratio",
      "description": "Share of all requests answered with a 5xx status.",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "(sum(rate(intelligence_api_http_request_duration_seconds_count{app=~\"$app\",instance=~\"$instance\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(intelligence_api_http_request_duration_seconds_count{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4, "type": "stat", "title": "Lookup p95",
      "description": "95th percentile latency of POST /v1/domain/lookup and POST /v1/ip/lookup, as the caller sees it.",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(intelligence_api_http_request_duration_seconds_bucket{app=~\"$app\",instance=~\"$instance\",route=~\"/v1/(domain|ip)/lookup\"}[$__rate_interval])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5, "type": "stat", "title": "Cache hit ratio",
      "description": "Share of cacheable lookups answered from Redis. geo is never cached and is not counted.",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "(sum(rate(intelligence_api_cache_requests_total{app=~\"$app\",instance=~\"$instance\",result=\"hit\"}[$__rate_interval])) or vector(0)) / sum(rate(intelligence_api_cache_requests_total{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1 }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6, "type": "stat", "title": "GeoIP age",
      "description": "Time since the loaded DB-IP database was built. DB-IP publishes monthly and geoip.max_age (720h by default) triggers a refresh at startup, so much past five weeks means the refresh is not happening. No data means no database is loaded.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "instant": true, "expr": "time() - min(intelligence_api_geoip_database_build_timestamp_seconds{app=~\"$app\",instance=~\"$instance\"})" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations", "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 3024000 }, { "color": "red", "value": 5184000 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },

    { "id": 100, "type": "row", "title": "HTTP", "collapsed": false, "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 10, "type": "timeseries", "title": "Requests by status",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{status}}", "expr": "sum by (status) (rate(intelligence_api_http_request_duration_seconds_count{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Requests by route",
      "description": "Routes are the registered templates. Anything that matched no route is counted under \"unmatched\".",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{method}} {{route}}", "expr": "sum by (method, route) (rate(intelligence_api_http_request_duration_seconds_count{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 12, "type": "timeseries", "title": "Lookup endpoint latency",
      "description": "Request latency of the two lookup endpoints, end to end. The per-lookup fetch times are in the Lookups row.",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "p50 {{route}}", "expr": "histogram_quantile(0.50, sum by (le, route) (rate(intelligence_api_http_request_duration_seconds_bucket{app=~\"$app\",instance=~\"$instance\",route=~\"/v1/(domain|ip)/lookup\"}[$__rate_interval])))" },
        { "refId": "B", "legendFormat": "p95 {{route}}", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(intelligence_api_http_request_duration_seconds_bucket{app=~\"$app\",instance=~\"$instance\",route=~\"/v1/(domain|ip)/lookup\"}[$__rate_interval])))" },
        { "refId": "C", "legendFormat": "p99 {{route}}", "expr": "histogram_quantile(0.99, sum by (le, route) (rate(intelligence_api_http_request_duration_seconds_bucket{app=~\"$app\",instance=~\"$instance\",route=~\"/v1/(domain|ip)/lookup\"}[$__rate_interval])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 13, "type": "timeseries", "title": "Requests by plan",
      "description": "\"none\" is every request that carried no valid API key: docs pages, health checks, failed authentication.",
      "gridPos": { "x": 12, "y": 13, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{plan}}", "expr": "sum by (plan) (rate(intelligence_api_http_request_duration_seconds_count{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 14, "type": "timeseries", "title": "Rate-limit rejections by plan",
      "description": "Requests answered 429 by the rate limiter. Empty until the first rejection.",
      "gridPos": { "x": 18, "y": 13, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{plan}}", "expr": "sum by (plan) (rate(intelligence_api_rate_limit_rejections_total{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "noValue": "0", "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    { "id": 101, "type": "row", "title": "Lookups", "collapsed": false, "gridPos": { "x": 0, "y": 21, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 20, "type": "timeseries", "title": "Live fetches by lookup",
      "description": "Lookups that actually went upstream. Cache hits and callers that shared another caller's fetch are not here. fingerprint and risk never appear: both are computed from other lookups.",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{scope}} {{lookup}}", "expr": "sum by (scope, lookup) (rate(intelligence_api_lookup_duration_seconds_count{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0, "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 21, "type": "timeseries", "title": "Fetch duration p95 by lookup",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{scope}} {{lookup}}", "expr": "histogram_quantile(0.95, sum by (le, scope, lookup) (rate(intelligence_api_lookup_duration_seconds_bucket{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 22, "type": "timeseries", "title": "Failure ratio by lookup",
      "description": "Share of live fetches that ended in an error or a timeout. A fan-out lookup (reputation, threat_intel) counts as failed when any provider errored, even if it returned a partial result.",
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{scope}} {{lookup}}", "expr": "(sum by (scope, lookup) (rate(intelligence_api_lookup_duration_seconds_count{app=~\"$app\",instance=~\"$instance\",outcome!=\"ok\"}[$__rate_interval])) or sum by (scope, lookup) (rate(intelligence_api_lookup_duration_seconds_count{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval])) * 0) / sum by (scope, lookup) (rate(intelligence_api_lookup_duration_seconds_count{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 23, "type": "timeseries", "title": "Fetch outcomes",
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{outcome}}", "expr": "sum by (outcome) (rate(intelligence_api_lookup_duration_seconds_count{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0, "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ok" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "timeout" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    { "id": 102, "type": "row", "title": "Cache", "collapsed": false, "gridPos": { "x": 0, "y": 38, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 30, "type": "timeseries", "title": "Cache hit ratio by lookup",
      "description": "A failed cache read and an unusable entry both count as misses, since both end in a live fetch.",
      "gridPos": { "x": 0, "y": 39, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{scope}} {{lookup}}", "expr": "(sum by (scope, lookup) (rate(intelligence_api_cache_requests_total{app=~\"$app\",instance=~\"$instance\",result=\"hit\"}[$__rate_interval])) or sum by (scope, lookup) (rate(intelligence_api_cache_requests_total{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval])) * 0) / sum by (scope, lookup) (rate(intelligence_api_cache_requests_total{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 31, "type": "timeseries", "title": "Coalesced calls by lookup",
      "description": "Calls that waited on another caller's in-flight fetch of the same lookup for the same target, instead of making their own upstream call. Empty until it first happens.",
      "gridPos": { "x": 12, "y": 39, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{scope}} {{lookup}}", "expr": "sum by (scope, lookup) (rate(intelligence_api_singleflight_coalesced_total{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0, "noValue": "0", "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    { "id": 103, "type": "row", "title": "Dependencies", "collapsed": false, "gridPos": { "x": 0, "y": 47, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 40, "type": "timeseries", "title": "Postgres pool",
      "description": "database/sql connection pool, summed over the selected instances. In use reaching the limit means requests are queueing for a connection.",
      "gridPos": { "x": 0, "y": 48, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "in use", "expr": "sum(go_sql_in_use_connections{app=~\"$app\",instance=~\"$instance\"})" },
        { "refId": "B", "legendFormat": "idle", "expr": "sum(go_sql_idle_connections{app=~\"$app\",instance=~\"$instance\"})" },
        { "refId": "C", "legendFormat": "limit", "expr": "sum(go_sql_max_open_connections{app=~\"$app\",instance=~\"$instance\"})" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 41, "type": "timeseries", "title": "Postgres pool waits",
      "description": "How often a query had to wait for a connection, and how long those waits took in total per second.",
      "gridPos": { "x": 6, "y": 48, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "waits/s", "expr": "sum(rate(go_sql_wait_count_total{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" },
        { "refId": "B", "legendFormat": "seconds waited/s", "expr": "sum(rate(go_sql_wait_duration_seconds_total{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 42, "type": "timeseries", "title": "Redis pool",
      "description": "The one go-redis pool the cache and the rate limiter share, summed over the selected instances.",
      "gridPos": { "x": 12, "y": 48, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "connections", "expr": "sum(intelligence_api_redis_pool_connections{app=~\"$app\",instance=~\"$instance\"})" },
        { "refId": "B", "legendFormat": "idle", "expr": "sum(intelligence_api_redis_pool_idle_connections{app=~\"$app\",instance=~\"$instance\"})" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 43, "type": "timeseries", "title": "Redis pool events",
      "description": "New connections dialed because none was free, waits for a connection that timed out, and stale connections dropped. Sustained timeouts mean the pool is too small or Redis is slow.",
      "gridPos": { "x": 18, "y": 48, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "dialed", "expr": "sum(rate(intelligence_api_redis_pool_misses_total{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" },
        { "refId": "B", "legendFormat": "timeouts", "expr": "sum(rate(intelligence_api_redis_pool_timeouts_total{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" },
        { "refId": "C", "legendFormat": "stale removed", "expr": "sum(rate(intelligence_api_redis_pool_stale_connections_total{app=~\"$app\",instance=~\"$instance\"}[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "id": 104, "type": "row", "title": "Runtime", "collapsed": false, "gridPos": { "x": 0, "y": 56, "w": 24, "h": 1 }, "panels": [] },
    {
      "id": 50, "type": "timeseries", "title": "GeoIP database loaded",
      "description": "1 while an instance has a GeoIP database loaded. 0 for the first seconds after a start on an empty volume is normal: the database downloads in the background.",
      "gridPos": { "x": 0, "y": 57, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{instance}}", "expr": "intelligence_api_geoip_database_loaded{app=~\"$app\",instance=~\"$instance\"}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1, "decimals": 0, "custom": { "lineInterpolation": "stepAfter", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 51, "type": "timeseries", "title": "Goroutines",
      "gridPos": { "x": 6, "y": 57, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "legendFormat": "{{instance}}", "expr": "go_goroutines{app=~\"$app\",instance=~\"$instance\"}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
