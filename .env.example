# Copy to .env and fill in your values.
# All values are optional unless noted — the API runs with sensible defaults.

# --- Smoke suite / sactl API keys ---
# One key per plan. The suite exercises every lookup against every plan, so all
# three are needed for full coverage; a missing one turns its checks into skips.
SMOKE_ADMIN_KEY=
SMOKE_PRO_KEY=
SMOKE_FREE_KEY=

# Extra free-plan keys, pooled and used round-robin. The limiter is per key per
# minute and free allows 5, so a full run needs more than one key or it spends
# minutes waiting out windows. Numbered siblings are picked up automatically
# (_2, _3, ...), as is a comma-separated SMOKE_FREE_KEYS. Mint more with:
#   sactl --allow-writes customer create --name "Smoke Free 4" --plan free
SMOKE_FREE_KEY_2=
SMOKE_FREE_KEY_3=

# A free-plan key reserved for the rate limit check and excluded from the pool.
# That check has to exhaust one key's window, which is the opposite of what the
# pool is for: rotating would never reach the limit, and reusing a pooled key
# would stall whichever later check drew it. Without this the check is skipped.
SMOKE_RATELIMIT_KEY=

# --- Stripe billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICES_PRO_MONTHLY=
STRIPE_PAYMENT_LINK_PRO=
STRIPE_PORTAL_LINK=

# --- Database (production) ---
NEON_CONNECTION_STRING=

# --- Threat intelligence providers ---
THREAT_INTEL_VIRUSTOTAL_API_KEY=
THREAT_INTEL_ALIENVAULT_API_KEY=

# --- GeoIP (DB-IP Lite, downloaded automatically; no key needed) ---
# GEOIP_DB_PATH=/data/geoip

# --- IP lookup (defaults shown, override as needed) ---
# IP_LOOKUP_TIMEOUT=30s
# IP_MAX_IPS_FREE=1
# IP_MAX_IPS_PRO=20
